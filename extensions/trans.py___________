def handler_atrans_control(type, source, body):
	if source[1] in GROUPCHATS:
		if body:
			body = body.lower()
			filename = 'dynamic/'+source[1]+'/atrans.txt'
			if body in [u'вкл', 'on', '1']:
				ATRANS[source[1]] = 'on'
				write_file(filename, "'on'")
				reply(type, source, u'авто-автоперевод включен')
			elif body in [u'выкл', 'off', '0']:
				ATRANS[source[1]] = 'off'
				write_file(filename, "'off'")
				reply(type, source, u'авто-перевод выключен')
			else:
				reply(type, source, u'читай помощь по команде')
		else:
			if ATRANS[source[1]] == 'off':
				reply(type, source, u'сейчас авто-перевод выключен')
			else:
				reply(type, source, u'сейчас авто-перевод включен')
	else:
		reply(type, source, u'только в чате мудак!')

def atrans_init(conf):
	if check_file(conf, 'atrans.txt', "'off'"):
		state = eval(read_file('dynamic/'+conf+'/atrans.txt'))
	else:
		state = 'on'
		delivery(u'Внимание! Не удалось создать atrans.txt для "%s"!' % (conf))
	ATRANS[conf] = state

